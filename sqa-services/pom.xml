<?xml version="1.0" encoding="UTF-8"?>
<!--
    Транспортные контракты: записи, которые приходят в теле запроса.
    Здесь только API аннотаций (Jackson, Bean Validation, OpenAPI, JAXB) —
    без парсеров, валидаторов и Spring. Реализации подключает cqa-server.

    Направление зависимостей: cqa-server → cqa-business → cqa-dto.
    DTO — только данные, без методов и без зависимостей на свои модули;
    в домен их превращает cqa-business.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ru.cqa</groupId>
        <artifactId>sqa-services</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>sqa-services</artifactId>
    <packaging>jar</packaging>

    <name>CQA Servicrs</name>
    <description>Реализации контрактов правил и сценариев</description>

    <!--
        BOM Spring Boot сюда не импортируется, поэтому версии явные.
        Держать их равными тем, что приезжают в cqa-server
        (mvn -pl cqa-server dependency:tree), иначе на classpath будет две версии.
    -->
    <properties>
        <jackson-annotations.version>2.21</jackson-annotations.version>
        <jakarta-validation.version>3.1.1</jakarta-validation.version>
        <swagger-annotations.version>2.2.55</swagger-annotations.version>
        <jakarta-xml-bind.version>4.0.5</jakarta-xml-bind.version>
    </properties>

    <dependencies>
        <!-- @JsonProperty и прочие; сам парсер живёт в cqa-server -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson-annotations.version}</version>
        </dependency>

        <!-- @NotBlank и прочие; проверяющий движок (hibernate-validator) — в cqa-server -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta-validation.version}</version>
        </dependency>

        <!-- @Schema для OpenAPI; именно -jakarta, его же тянет springdoc -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger-annotations.version}</version>
        </dependency>

        <!-- @XmlRootElement и прочие для SOAP-DTO; сам JAXB (runtime) — в cqa-server -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>${jakarta-xml-bind.version}</version>
        </dependency>
    </dependencies>

</project>
