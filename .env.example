# =============================================================================
#  Переменные окружения CQA Server — шаблон
#
#  Скопировать в .env и заполнить. Сам .env в гит не попадает.
#  .env подключён в application.yml через spring.config.import и читается
#  из рабочего каталога (корень проекта). Переменные окружения процесса
#  (run-конфигурация IDEA, systemd, export в shell) важнее значений из файла.
#  Формат — properties: символ \ в значении нужно удваивать.
# =============================================================================


# --- Веб-сервер --------------------------------------------------------------

# порт HTTP (необязательно, по умолчанию 8990)
SERVER_PORT=8990


# --- БД журнала запросов (SQLite) --------------------------------------------

# адрес БД (необязательно, по умолчанию файл cqa-journal.db в рабочем каталоге
# с параметрами из application.yml); при замене параметры соединения указать заново
#CQA_DB_URL=jdbc:sqlite:cqa-journal.db?foreign_keys=true&journal_mode=WAL&busy_timeout=5000


# --- CDI, контур DEV ---------------------------------------------------------

# адрес сервиса (обязательно)
CDI_DEV_URL=так
# логин (обязательно)
CDI_DEV_USER=
# пароль (обязательно)
CDI_DEV_PASSWORD=
